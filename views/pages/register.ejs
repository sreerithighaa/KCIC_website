<%- include('../partials/header', { title: 'Register', activePage: '' }) %>

<div class="container py-5" style="min-height:calc(100vh - 130px)">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">
      <div class="bg-white rounded-4 shadow-sm overflow-hidden">
        <div class="row g-0">

          <!-- Left panel -->
          <div class="col-12 col-md-4 auth-left d-none d-md-flex">
            <h4 class="fw-bold text-navy mb-2" style="font-family:'Playfair Display',serif">Create Your Account!</h4>
            <p class="text-kcic-muted small mb-3">
              Join the academic blogging platform and contribute to your department.
            </p>
            <div class="auth-logo-box">
               <img src="/assets/logo.png" alt="KCIC" class="logo-img" onerror="this.style.display='none'" />
            </div>
            <a href="/login" class="btn btn-outline-secondary w-100 mt-3">Sign In</a>
          </div>

          <!-- Right panel -->
          <div class="col-12 col-md-8 auth-right">
            <nav aria-label="breadcrumb" class="mb-3">
              <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="/home" class="text-kcic-muted text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-kcic-muted">Register</li>
              </ol>
            </nav>

            <h3 class="fw-bold text-navy mb-1" style="font-family:'Playfair Display',serif">Create Account</h3>
            <p class="text-kcic-muted small mb-4">Get started with your academic journey.</p>

            <div id="reg-error" class="alert alert-danger py-2 small d-none"></div>

            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold">Full Name</label>
                <input type="text" id="name" class="form-control" placeholder="Full Name" />
                <div class="invalid-feedback d-block" id="name-err"></div>
              </div>
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold">Email</label>
                <input type="email" id="email" class="form-control" placeholder="name@cornerstone.edu.in" />
                <div class="invalid-feedback d-block" id="email-err"></div>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold">Password</label>
                <div class="input-group">
                  <input type="password" id="password" class="form-control"
                         placeholder="Min 8 characters" oninput="checkStrength(this.value)" />
                  <button class="btn btn-outline-secondary" type="button" id="pw-toggle">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div class="strength-bar mt-1" id="strength-bar"></div>
                <div class="d-flex justify-content-between">
                  <div class="invalid-feedback d-block" id="pw-err"></div>
                  <small id="strength-label" class="text-kcic-muted">Strength: —</small>
                </div>
              </div>
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold">Confirm Password</label>
                <div class="input-group">
                  <input type="password" id="confirm-pw" class="form-control" placeholder="Confirm password" />
                  <button class="btn btn-outline-secondary" type="button" id="cpw-toggle">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div class="invalid-feedback d-block" id="cpw-err"></div>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold">Department</label>
                <select id="dept" class="form-select">
                  <option value="">Select department</option>
                  <option value="1">Computing</option>
                  <option value="2">Business</option>
                  <option value="3">Engineering</option>
                  <option value="4">Applied Science</option>
                </select>
                <div class="invalid-feedback d-block" id="dept-err"></div>
              </div>
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold">Role</label>
                <select id="role" class="form-select">
                  <option value="">Select role</option>
                  <option value="3">Student</option>
                  <option value="2">Assessor / Department Head</option>
                </select>
                <div class="invalid-feedback d-block" id="role-err"></div>
              </div>
            </div>

            <div class="form-check mb-4">
              <input class="form-check-input" type="checkbox" id="terms" />
              <label class="form-check-label small" for="terms">
                I agree to the <a href="#" style="color:var(--kcic-accent)">Terms of Service</a>
              </label>
              <div class="invalid-feedback d-block" id="terms-err"></div>
            </div>

            <button class="btn btn-gold w-100 py-2" id="reg-btn" onclick="doRegister()">
              Create Account
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
  if (Auth.isLoggedIn()) location.href = '/dashboard';

  // Password toggles
  [['pw-toggle','password'],['cpw-toggle','confirm-pw']].forEach(([btnId, inpId]) => {
    document.getElementById(btnId).addEventListener('click', () => {
      const inp = document.getElementById(inpId);
      const icon = document.querySelector(`#${btnId} i`);
      inp.type = inp.type === 'password' ? 'text' : 'password';
      icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    });
  });

  function checkStrength(val) {
    const bar = document.getElementById('strength-bar');
    const lbl = document.getElementById('strength-label');
    if (!val) { bar.className = 'strength-bar'; lbl.textContent = 'Strength: —'; return; }
    if (val.length < 6)                                    { bar.className = 'strength-bar weak';   lbl.textContent = 'Strength: Weak'; }
    else if (val.length < 10 || !/[A-Z]/.test(val) || !/\d/.test(val)) { bar.className = 'strength-bar fair';   lbl.textContent = 'Strength: Fair'; }
    else                                                   { bar.className = 'strength-bar strong'; lbl.textContent = 'Strength: Strong'; }
  }

  async function doRegister() {
    const name    = document.getElementById('name').value.trim();
    const email   = document.getElementById('email').value.trim();
    const pw      = document.getElementById('password').value;
    const cpw     = document.getElementById('confirm-pw').value;
    const dept_id = document.getElementById('dept').value;
    const role_id = document.getElementById('role').value;
    const terms   = document.getElementById('terms').checked;

    ['name-err','email-err','pw-err','cpw-err','dept-err','role-err','terms-err']
      .forEach(id => document.getElementById(id).textContent = '');
    document.getElementById('reg-error').classList.add('d-none');

    let ok = true;
    if (!name)       { document.getElementById('name-err').textContent = 'Full name required'; ok = false; }
    if (!email)      { document.getElementById('email-err').textContent = 'Email required'; ok = false; }
    if (pw.length<8) { document.getElementById('pw-err').textContent = 'Minimum 8 characters'; ok = false; }
    if (pw !== cpw)  { document.getElementById('cpw-err').textContent = 'Passwords do not match'; ok = false; }
    if (!dept_id)    { document.getElementById('dept-err').textContent = 'Select your department'; ok = false; }
    if (!role_id)    { document.getElementById('role-err').textContent = 'Select your role'; ok = false; }
    if (!terms)      { document.getElementById('terms-err').textContent = 'You must agree to Terms'; ok = false; }
    if (!ok) return;

    const btn = document.getElementById('reg-btn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating…';

    try {
      await api('/auth/register', { method: 'POST', body: { name, email, password: pw, role_id: +role_id, dept_id: +dept_id } });
      toast('Account created! Please sign in.', 'success');
      setTimeout(() => location.href = '/login', 1000);
    } catch(e) {
      const errEl = document.getElementById('reg-error');
      errEl.textContent = e.message || 'Registration failed';
      errEl.classList.remove('d-none');
      btn.disabled = false; btn.textContent = 'Create Account';
    }
  }
</script>
