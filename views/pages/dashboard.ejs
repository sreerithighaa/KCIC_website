/* ── ANNOUNCEMENTS ── */
var _anns=[];
function viewAnns(){
  document.getElementById('dash-title').textContent='Manage Announcements';
  var body=document.getElementById('dash-body');
  api('/announcements?limit=200').then(function(data){
    _anns=data.announcements||[];
    body.innerHTML=
      '<div class="mb-3"><button class="btn btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#annModal"><i class="bi bi-megaphone me-1"></i>New Announcement</button></div>'+
      buildSearchBar({fields:[{type:'text',id:'an-q',placeholder:'Search by title\u2026'},{type:'text',id:'an-author',placeholder:'Search by author\u2026'},{type:'select',id:'an-cat',label:'Categories',options:[{v:'general',l:'General'},{v:'academic',l:'Academic'},{v:'event',l:'Event'},{v:'urgent',l:'Urgent'}]},{type:'text',id:'an-date',placeholder:'Date (YYYY-MM-DD)'}],onSearch:'renderAnns()',onClear:'clearSearch([\'an-q\',\'an-author\',\'an-cat\',\'an-date\']);renderAnns()'})+
      '<div id="an-count" class="search-result-count"></div><div id="an-wrap"></div>';
    renderAnns();
  }).catch(function(){document.getElementById('dash-body').innerHTML='<p class="text-muted">Failed to load.</p>';});
}
function renderAnns(){
  var q=getVal('an-q'),author=getVal('an-author'),cat=getVal('an-cat'),date=getVal('an-date');
  var f=_anns.filter(function(a){
    if(q      && !(a.title||'').toLowerCase().includes(q))          return false;
    if(author && !(a.author_name||'').toLowerCase().includes(author)) return false;
    if(cat    && (a.category||'')!==cat)                             return false;
    if(date){ var d=a.created_at?new Date(a.created_at).toISOString().slice(0,10):''; if(!d.includes(date)) return false; }
    return true;
  });
  showCount('an-count',f.length,_anns.length,'announcements');
  var wrap=document.getElementById('an-wrap'); if(!wrap)return;
  if(!f.length){wrap.innerHTML=noResultsHtml();return;}
  var rows='';
  f.forEach(function(a){
    rows+='<tr><td class="small fw-semibold">'+a.title+'</td><td><span class="ann-cat-'+a.category+' small fw-semibold text-uppercase" style="font-size:.72rem;letter-spacing:.05em">'+a.category+'</span></td><td class="small text-muted">'+fmtDate(a.created_at)+'</td><td>'+a.author_name+'</td><td><button class="btn btn-danger btn-sm" onclick="deleteAnn('+a.ann_id+')"><i class="bi bi-trash"></i></button></td></tr>';
  });
  wrap.innerHTML='<div class="bg-white border rounded-3 overflow-hidden"><table class="table table-hover mb-0"><thead class="table-light"><tr><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Title</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Category</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Date</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Author</th><th></th></tr></thead><tbody>'+rows+'</tbody></table></div>';
}

/* ── MANAGE USERS ── */
var _users=[];
function viewUsers(){
  document.getElementById('dash-title').textContent='Manage Users';
  var body=document.getElementById('dash-body');
  api('/dashboard/admin/users').then(function(users){
    _users=users;
    body.innerHTML=
      buildSearchBar({fields:[{type:'text',id:'us-q',placeholder:'Search by name or email\u2026'},{type:'select',id:'us-dept',label:'Departments',options:[{v:'1',l:'Computing'},{v:'2',l:'Business'},{v:'3',l:'Engineering'},{v:'4',l:'Applied Science'}]},{type:'text',id:'us-date',placeholder:'Joined date (YYYY-MM-DD)'}],onSearch:'renderUsers()',onClear:'clearSearch([\'us-q\',\'us-dept\',\'us-date\']);renderUsers()'})+
      '<div id="us-count" class="search-result-count"></div><div id="us-wrap"></div>';
    renderUsers();
  }).catch(function(){document.getElementById('dash-body').innerHTML='<p class="text-muted">Failed to load users.</p>';});
}
function renderUsers(){
  var q=getVal('us-q'),dept=getVal('us-dept'),date=getVal('us-date');
  var f=_users.filter(function(u){
    if(q    && !(u.name||'').toLowerCase().includes(q) && !(u.email||'').toLowerCase().includes(q)) return false;
    if(dept && String(u.dept_id)!==dept && !(u.dept_name||'').toLowerCase().includes(dept))        return false;
    if(date){ var d=u.created_at?new Date(u.created_at).toISOString().slice(0,10):''; if(!d.includes(date)) return false; }
    return true;
  });
  showCount('us-count',f.length,_users.length,'users');
  var wrap=document.getElementById('us-wrap'); if(!wrap)return;
  if(!f.length){wrap.innerHTML=noResultsHtml();return;}
  var rows='';
  f.forEach(function(u){
    var sb='<span class="badge rounded-pill '+(u.is_active?'badge-approved':'badge-rejected')+'">'+(u.is_active?'Active':'Disabled')+'</span>';
    var acts='<button class="btn btn-outline-secondary btn-sm me-1" onclick="toggleUser('+u.user_id+')">'+(u.is_active?'Disable':'Enable')+'</button><button class="btn btn-danger btn-sm" onclick="deleteUser('+u.user_id+')"><i class="bi bi-trash"></i></button>';
    rows+='<tr><td class="small fw-semibold">'+u.name+'</td><td class="small text-muted">'+u.email+'</td><td class="small">'+u.role_name+'</td><td class="small">'+(u.dept_name||'—')+'</td><td>'+sb+'</td><td class="small text-muted">'+fmtDate(u.created_at)+'</td><td>'+acts+'</td></tr>';
  });
  wrap.innerHTML='<p class="small text-muted mb-2">Total: <strong>'+_users.length+'</strong></p><div class="bg-white border rounded-3 overflow-hidden"><table class="table table-hover mb-0"><thead class="table-light"><tr><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Name</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Email</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Role</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Department</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Status</th><th class="small text-uppercase text-muted fw-semibold" style="font-size:.75rem">Joined</th><th></th></tr></thead><tbody>'+rows+'</tbody></table></div>';
}

