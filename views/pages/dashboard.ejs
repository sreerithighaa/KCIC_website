<%- include('../partials/header', { title: 'Dashboard', activePage: '' }) %>

<style>
/* ── Existing styles ── */
.welcome-banner{background:var(--kcic-accent-bg);border:1px solid #d4dcf7;border-radius:10px;padding:1rem 1.25rem;font-size:.92rem;color:#1a2744;}
.user-dept{font-size:.72rem;color:var(--kcic-accent);margin-top:.15rem;font-weight:500;}
.pending-card{background:#fff;border:1px solid var(--kcic-border);border-radius:10px;padding:1.2rem;margin-bottom:.8rem;}
.ann-cat-general{color:var(--kcic-accent);}
.ann-cat-academic{color:#7c3aed;}
.ann-cat-event{color:#d97706;}
.ann-cat-urgent{color:#dc2626;}

/* ── Breadcrumb ── */
.dash-breadcrumb{display:flex;align-items:center;gap:.3rem;font-size:.8rem;color:var(--kcic-muted);margin-bottom:.35rem;flex-wrap:wrap;}
.dash-breadcrumb a{color:var(--kcic-accent);text-decoration:none;}
.dash-breadcrumb a:hover{text-decoration:underline;}
.dash-breadcrumb .bc-sep{color:#c5cad8;}
.dash-breadcrumb .bc-current{color:var(--kcic-navy);font-weight:500;}

/* ── Notification Bell ── */
.notif-bell-wrap{position:relative;display:inline-flex;align-items:center;}
.notif-badge{position:absolute;top:-4px;right:-4px;background:#dc2626;color:#fff;font-size:.6rem;font-weight:700;border-radius:50%;width:16px;height:16px;display:flex;align-items:center;justify-content:center;pointer-events:none;}
.notif-dropdown{position:absolute;top:calc(100% + 8px);right:0;width:300px;background:#fff;border:1px solid var(--kcic-border);border-radius:10px;box-shadow:0 8px 24px rgba(26,39,68,.14);z-index:1050;display:none;}
.notif-dropdown.show{display:block;}
.notif-header{padding:.75rem 1rem;border-bottom:1px solid var(--kcic-border);font-weight:600;font-size:.85rem;color:var(--kcic-navy);}
.notif-item{padding:.65rem 1rem;border-bottom:1px solid #f1f3f8;font-size:.8rem;color:var(--kcic-navy);cursor:pointer;}
.notif-item:hover{background:var(--kcic-accent-bg);}
.notif-item:last-child{border-bottom:none;}
.notif-empty{padding:1.2rem 1rem;text-align:center;color:var(--kcic-muted);font-size:.82rem;}
.notif-item .ni-title{font-weight:500;margin-bottom:.1rem;}
.notif-item .ni-sub{color:var(--kcic-muted);font-size:.75rem;}

/* ── Search Bar ── */
.dash-search-bar{background:#fff;border:1px solid var(--kcic-border);border-radius:10px;padding:.75rem 1rem;margin-bottom:1rem;}
.dash-search-bar .search-inner{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;}
.dash-search-bar input,.dash-search-bar select{border:1px solid var(--kcic-border);border-radius:8px;padding:.4rem .75rem;font-size:.84rem;color:var(--kcic-navy);background:#fff;outline:none;}
.dash-search-bar input:focus,.dash-search-bar select:focus{border-color:var(--kcic-accent);box-shadow:0 0 0 3px rgba(79,111,209,.12);}
.dash-search-bar input[type=text]{flex:1;min-width:140px;}
.dash-search-bar .btn-search{background:var(--kcic-accent);color:#fff;border:none;border-radius:8px;padding:.4rem 1rem;font-size:.84rem;cursor:pointer;white-space:nowrap;}
.dash-search-bar .btn-search:hover{background:#3d5abf;}
.dash-search-bar .btn-clear-search{background:transparent;color:var(--kcic-muted);border:1px solid var(--kcic-border);border-radius:8px;padding:.4rem .75rem;font-size:.82rem;cursor:pointer;}
.dash-search-bar .btn-clear-search:hover{color:var(--kcic-navy);border-color:#aaa;}
.search-result-count{font-size:.8rem;color:var(--kcic-muted);margin-bottom:.5rem;}
</style>

<!-- Mobile top bar -->
<div class="d-flex d-md-none align-items-center justify-content-between px-3 py-2 bg-white border-bottom">
  <span class="fw-semibold" style="font-family:'Playfair Display',serif;color:#1a2744">Dashboard</span>
  <div class="d-flex align-items-center gap-2">
    <div class="notif-bell-wrap" id="notif-wrap-m">
      <button class="btn btn-outline-secondary btn-sm" onclick="toggleNotif('m')" title="Notifications">
        <i class="bi bi-bell"></i>
      </button>
      <span class="notif-badge d-none" id="notif-badge-m">0</span>
      <div class="notif-dropdown" id="notif-dropdown-m">
        <div class="notif-header"><i class="bi bi-bell me-1"></i>Notifications</div>
        <div id="notif-list-m"><div class="notif-empty">Loading…</div></div>
      </div>
    </div>
    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#dashOffcanvas">
      <i class="bi bi-layout-sidebar-inset"></i> Menu
    </button>
  </div>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="dashOffcanvas" style="width:240px">
  <div class="offcanvas-header border-bottom">
    <h6 class="offcanvas-title fw-bold" style="font-family:'Playfair Display',serif;color:#1a2744">Navigation</h6>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body p-0">
    <div class="user-info px-3 py-2 border-bottom">
      <div class="user-name" id="sb-name-m">—</div>
      <div class="user-role" id="sb-role-m">—</div>
      <div class="user-dept" id="sb-dept-m"></div>
    </div>
    <nav class="dash-nav" id="dash-nav-m"></nav>
  </div>
</div>

<div class="dash-wrapper">
  <aside class="dash-sidebar d-none d-md-block">
    <div class="user-info">
      <div class="user-name" id="sb-name">—</div>
      <div class="user-role" id="sb-role">—</div>
      <div class="user-dept" id="sb-dept"></div>
    </div>
    <nav class="dash-nav" id="dash-nav"></nav>
  </aside>

  <main class="dash-main">
    <!-- Header: breadcrumb + notification bell -->
    <div class="d-flex align-items-start justify-content-between mb-2 flex-wrap gap-2">
      <div>
        <nav class="dash-breadcrumb" id="dash-breadcrumb" aria-label="breadcrumb">
          <a href="#" onclick="loadView('overview');return false">Dashboard</a>
          <span class="bc-sep">&#8250;</span>
          <span class="bc-current" id="bc-current">Overview</span>
        </nav>
        <h4 id="dash-title" style="font-family:'Playfair Display',serif;color:#1a2744;margin-bottom:0">Dashboard</h4>
      </div>
      <div class="notif-bell-wrap d-none d-md-flex" id="notif-wrap">
        <button class="btn btn-outline-secondary btn-sm" onclick="toggleNotif('')" title="Notifications">
          <i class="bi bi-bell me-1"></i>Notifications
        </button>
        <span class="notif-badge d-none" id="notif-badge">0</span>
        <div class="notif-dropdown" id="notif-dropdown">
          <div class="notif-header"><i class="bi bi-bell me-1"></i>Notifications</div>
          <div id="notif-list"><div class="notif-empty">Loading…</div></div>
        </div>
      </div>
    </div>

    <div id="dash-body">
      <div class="text-center py-5 text-muted">
        <div class="spinner-border spinner-border-sm me-2"></div>Loading…
      </div>
    </div>
  </main>
</div>

<!-- Post Modal -->
<div class="modal fade" id="postModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content rounded-4">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold" style="font-family:'Playfair Display',serif;color:#1a2744">Submit New Blog Post</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body px-4">
        <div class="mb-3"><label class="form-label small fw-semibold">Title</label><input type="text" id="post-title" class="form-control" placeholder="Post title" /></div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Department</label>
          <select id="post-dept" class="form-select">
            <option value="">Select department</option>
            <option value="1">Computing</option>
            <option value="2">Business</option>
            <option value="3">Engineering</option>
            <option value="4">Applied Science</option>
          </select>
        </div>
        <div class="mb-3"><label class="form-label small fw-semibold">Content</label><textarea id="post-content" class="form-control" rows="7" placeholder="Write your blog post here..."></textarea></div>
        <div class="mb-3"><label class="form-label small fw-semibold">Tags <span class="text-muted fw-normal">(comma separated)</span></label><input type="text" id="post-tags" class="form-control" placeholder="e.g. Technology, Research" /></div>
      </div>
      <div class="modal-footer border-0 px-4">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-gold px-4" onclick="submitPost()">Submit for Review</button>
      </div>
    </div>
  </div>
</div>

<!-- Announcement Modal -->
<div class="modal fade" id="annModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold" style="font-family:'Playfair Display',serif;color:#1a2744">New Announcement</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body px-4">
        <div class="mb-3"><label class="form-label small fw-semibold">Title</label><input type="text" id="ann-title" class="form-control" placeholder="Announcement title" /></div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Category</label>
          <select id="ann-cat" class="form-select">
            <option value="general">General</option>
            <option value="academic">Academic</option>
            <option value="event">Event</option>
            <option value="urgent">Urgent</option>
          </select>
        </div>
        <div class="mb-3"><label class="form-label small fw-semibold">Content</label><textarea id="ann-content" class="form-control" rows="5" placeholder="Announcement content..."></textarea></div>
      </div>
      <div class="modal-footer border-0 px-4">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-gold px-4" onclick="submitAnn()">Publish</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
var user = Auth.user();
if (!user) { setTimeout(function() { location.href = '/login'; }, 300); }

var ROLE = { ADMIN: 1, ASSESSOR: 2, STUDENT: 3 };
var DEPT_NAMES = { 1:'Computing', 2:'Business', 3:'Engineering', 4:'Applied Science' };

/* ── BREADCRUMB ── */
var VIEW_LABELS = {
  'overview':'Overview','my-posts':'My Posts','pending':'Pending Posts',
  'reviewed':'Reviewed Posts','ann-manage':'Announcements','users':'Manage Users','all-posts':'All Posts'
};
function setBreadcrumb(view) {
  var el = document.getElementById('bc-current');
  if (el) el.textContent = VIEW_LABELS[view] || view;
}

/* ── NOTIFICATIONS ── */
var _notifData = [];
function loadNotifications() {
  var endpoint = user.role_id === ROLE.ADMIN ? '/dashboard/admin/stats'
               : user.role_id === ROLE.ASSESSOR ? '/dashboard/assessor'
               : '/dashboard/student';
  api(endpoint).then(function(s) {
    var notifs = [];
    if (user.role_id === ROLE.ADMIN) {
      if (s.posts && s.posts.pending > 0)         notifs.push({title: s.posts.pending + ' posts awaiting review', sub:'Click to review', view:'pending'});
      if (s.users && s.users.total > 0)            notifs.push({title: s.users.total + ' registered users', sub:'Manage platform users', view:'users'});
      if (s.announcements && s.announcements.total > 0) notifs.push({title: s.announcements.total + ' announcements', sub:'Manage announcements', view:'ann-manage'});
    } else if (user.role_id === ROLE.ASSESSOR) {
      if (s.stats && s.stats.pending > 0)  notifs.push({title: s.stats.pending + ' posts need your review', sub:'Review pending posts', view:'pending'});
      if (s.stats && s.stats.approved > 0) notifs.push({title: s.stats.approved + ' posts approved', sub:'View reviewed posts', view:'reviewed'});
    } else {
      if (s.stats && s.stats.pending > 0)  notifs.push({title: s.stats.pending + ' post(s) pending review', sub:'Awaiting approval', view:'my-posts'});
      if (s.stats && s.stats.approved > 0) notifs.push({title: s.stats.approved + ' post(s) approved!', sub:'View your posts', view:'my-posts'});
      if (s.stats && s.stats.rejected > 0) notifs.push({title: s.stats.rejected + ' post(s) rejected', sub:'Check your posts', view:'my-posts'});
    }
    _notifData = notifs;
    renderNotifications();
  }).catch(function() {});
}
function renderNotifications() {
  var count = _notifData.length;
  ['notif-badge','notif-badge-m'].forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    if (count > 0) { el.textContent = count; el.classList.remove('d-none'); } else { el.classList.add('d-none'); }
  });
  ['notif-list','notif-list-m'].forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    if (!_notifData.length) { el.innerHTML = '<div class="notif-empty"><i class="bi bi-check-circle text-success me-1"></i>No new notifications</div>'; return; }
    el.innerHTML = _notifData.map(function(n) {
      return '<div class="notif-item" onclick="loadView(\'' + n.view + '\');closeNotif()">' +
        '<div class="ni-title">' + n.title + '</div><div class="ni-sub">' + n.sub + '</div></div>';
    }).join('');
  });
}
function toggleNotif(suffix) {
  var dd = document.getElementById('notif-dropdown' + (suffix ? '-'+suffix : ''));
  if (!dd) return;
  var isOpen = dd.classList.contains('show');
  closeNotif();
  if (!isOpen) dd.classList.add('show');
}
function closeNotif() { document.querySelectorAll('.notif-dropdown').forEach(function(d){d.classList.remove('show');}); }
document.addEventListener('click', function(e){ if(!e.target.closest('.notif-bell-wrap')) closeNotif(); });

/* ── SEARCH HELPERS ── */
function buildSearchBar(cfg) {
  var inner = '';
  cfg.fields.forEach(function(f) {
    if (f.type === 'select') {
      var opts = '<option value="">All ' + f.label + '</option>';
      (f.options||[]).forEach(function(o){ opts += '<option value="'+o.v+'">'+o.l+'</option>'; });
      inner += '<select id="'+f.id+'">'+opts+'</select>';
    } else {
      inner += '<input type="text" id="'+f.id+'" placeholder="'+(f.placeholder||'Search...')+'" />';
    }
  });
  inner += '<button class="btn-search" onclick="'+cfg.onSearch+'"><i class="bi bi-search me-1"></i>Search</button>';
  inner += '<button class="btn-clear-search" onclick="'+cfg.onClear+'">Clear</button>';
  return '<div class="dash-search-bar"><div class="search-inner">'+inner+'</div></div>';
}
function getVal(id) { var el=document.getElementById(id); return el ? el.value.trim().toLowerCase() : ''; }
function clearSearch(ids) { ids.forEach(function(id){ var el=document.getElementById(id); if(el) el.value=''; }); }
function filterPosts(posts, titleId, authorId, deptId, dateId) {
  var title  = titleId  ? getVal(titleId)  : '';
  var author = authorId ? getVal(authorId) : '';
  var dept   = deptId   ? getVal(deptId)   : '';
  var date   = dateId   ? getVal(dateId)   : '';
  return posts.filter(function(p) {
    if (title  && !(p.title       ||'').toLowerCase().includes(title))  return false;
    if (author && !(p.author_name ||'').toLowerCase().includes(author)) return false;
    if (dept   && String(p.dept_id) !== dept && !(p.dept_name||'').toLowerCase().includes(dept)) return false;
    if (date) { var d = p.created_at ? new Date(p.created_at).toISOString().slice(0,10) : ''; if(!d.includes(date)) return false; }
    return true;
  });
}
function showCount(id, shown, total, label) {
  var el=document.getElementById(id); if(el) el.textContent='Showing '+shown+' of '+total+' '+(label||'items');
}
function noResultsHtml() { return '<div class="text-center py-4 text-muted"><i class="bi bi-search me-1"></i>No items match your search.</div>'; }

/* ── ROLE / SIDEBAR ── */
function getRoleLabel() {
  if (user.role_id===ROLE.ADMIN) return 'Administrator';
  if (user.role_id===ROLE.ASSESSOR) return 'Department Head';
  if (user.role_id===ROLE.STUDENT) return 'Student';
  return user.role_name||'';
}
function getDeptLabel() {
  var d=user.dept_name||DEPT_NAMES[user.dept_id]||'';
  if (!d) return '';
  if (user.role_id===ROLE.ASSESSOR) return d+' Department Head';
  if (user.role_id===ROLE.STUDENT) return d;
  return '';
}
['sb-name','sb-name-m'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=user.name||'';});
['sb-role','sb-role-m'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=getRoleLabel();});
['sb-dept','sb-dept-m'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=getDeptLabel();});
var deptSel=document.getElementById('post-dept'); if(user.dept_id&&deptSel) deptSel.value=user.dept_id;

function buildSidebar() {
  var items=[{icon:'bi-speedometer2',label:'Overview',view:'overview'}];
  if (user.role_id===ROLE.STUDENT)   items.push({icon:'bi-file-text',label:'My Posts',view:'my-posts'});
  if (user.role_id===ROLE.ASSESSOR) { items.push({icon:'bi-hourglass-split',label:'Pending Posts',view:'pending'}); items.push({icon:'bi-journal-check',label:'Reviewed Posts',view:'reviewed'}); items.push({icon:'bi-megaphone',label:'Announcements',view:'ann-manage'}); }
  if (user.role_id===ROLE.ADMIN)    { items.push({icon:'bi-people',label:'Manage Users',view:'users'}); items.push({icon:'bi-journals',label:'All Posts',view:'all-posts'}); items.push({icon:'bi-hourglass-split',label:'Pending Posts',view:'pending'}); items.push({icon:'bi-megaphone',label:'Announcements',view:'ann-manage'}); }
  var html='';
  items.forEach(function(i){ html+='<a href="#" onclick="loadView(\''+i.view+'\');return false" data-view="'+i.view+'"><i class="bi '+i.icon+'"></i> '+i.label+'</a>'; });
  document.getElementById('dash-nav').innerHTML=html;
  document.getElementById('dash-nav-m').innerHTML=html;
}
function setActive(view) { document.querySelectorAll('.dash-nav a').forEach(function(a){a.classList.toggle('active',a.dataset.view===view);}); }
function welcomeMsg() {
  if (user.role_id===ROLE.ADMIN)    return 'Welcome back, <strong>'+user.name+'</strong>! You have full admin access to manage the platform.';
  if (user.role_id===ROLE.ASSESSOR) return 'Welcome back, <strong>'+user.name+'</strong>! Review and approve pending blog posts from your department.';
  return 'Welcome back, <strong>'+user.name+'</strong>! Submit academic blog posts for review and track your submissions.';
}
function loadView(view) {
  setActive(view); setBreadcrumb(view);
  document.getElementById('dash-body').innerHTML='<div class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Loading\u2026</div>';
  if (view==='overview')    viewOverview();
  else if (view==='my-posts')   viewMyPosts();
  else if (view==='pending')    viewPending();
  else if (view==='reviewed')   viewReviewed();
  else if (view==='ann-manage') viewAnns();
  else if (view==='users')      viewUsers();
  else if (view==='all-posts')  viewAllPosts();
}
function statsGrid(items) {
  var html='<div class="row g-3 mb-4">';
  items.forEach(function(i){ html+='<div class="col-6 col-md-4 col-lg-2"><div class="stat-card"><div class="stat-value">'+i.v+'</div><div class="stat-label">'+i.l+'</div></div></div>'; });
  return html+'</div>';
}

/* ── OVERVIEW ── */
function viewOverview() {
  document.getElementById('dash-title').textContent='Overview';
  var body=document.getElementById('dash-body');
  var banner='<div class="welcome-banner mb-4"><p class="mb-0">'+welcomeMsg()+'</p></div>';
  if (user.role_id===ROLE.ADMIN) {
    api('/dashboard/admin/stats').then(function(s){
      body.innerHTML=banner+statsGrid([{v:s.users.total,l:'Total Users'},{v:s.users.students,l:'Students'},{v:s.users.assessors,l:'Assessors'},{v:s.posts.total,l:'Total Posts'},{v:s.posts.pending,l:'Pending Posts'},{v:s.announcements.total,l:'Announcements'}])+
      '<div class="d-flex gap-2 flex-wrap"><button class="btn btn-gold btn-sm" onclick="loadView(\'users\')"><i class="bi bi-people me-1"></i>Manage Users</button><button class="btn btn-outline-secondary btn-sm" onclick="loadView(\'all-posts\')"><i class="bi bi-journals me-1"></i>All Posts</button><button class="btn btn-outline-secondary btn-sm" onclick="loadView(\'pending\')"><i class="bi bi-hourglass-split me-1"></i>Pending Posts</button><button class="btn btn-outline-secondary btn-sm" onclick="loadView(\'ann-manage\')"><i class="bi bi-megaphone me-1"></i>Announcements</button></div>';
    }).catch(function(){body.innerHTML=banner+'<p class="text-muted small">Could not load stats.</p>';});
  } else if (user.role_id===ROLE.ASSESSOR) {
    api('/dashboard/assessor').then(function(s){
      body.innerHTML=banner+statsGrid([{v:s.stats.pending,l:'Awaiting Review'},{v:s.stats.approved,l:'Approved'},{v:s.stats.rejected,l:'Rejected'}])+'<button class="btn btn-gold btn-sm" onclick="loadView(\'pending\')"><i class="bi bi-hourglass-split me-1"></i>Review Pending Posts</button>';
    }).catch(function(){body.innerHTML=banner+'<p class="text-muted small">Could not load stats.</p>';});
  } else {
    api('/dashboard/student').then(function(s){
      body.innerHTML=banner+statsGrid([{v:s.stats.total,l:'My Posts'},{v:s.stats.approved,l:'Approved'},{v:s.stats.pending,l:'Pending'},{v:s.stats.rejected,l:'Rejected'}])+'<button class="btn btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#postModal"><i class="bi bi-pencil me-1"></i>Write New Post</button>';
    }).catch(function(){body.innerHTML=banner+'<p class="text-muted small">Could not load stats.</p>';});
  }
}

/* ── MY POSTS (Student) ── */
var _myPosts=[];
function viewMyPosts() {
  document.getElementById('dash-title').textContent='My Posts';
  var body=document.getElementById('dash-body');
  api('/posts/my/posts').then(function(posts){
    _myPosts=posts;
    if (!posts.length){ body.innerHTML='<div class="text-center py-5 text-muted"><i class="bi bi-journal-x" style="font-size:2rem"></i><p class="mt-2">No posts yet.</p><button class="btn btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#postModal">Write Your First Post</button></div>'; return; }
    body.innerHTML=
      '<div class="mb-3"><button class="btn btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#postModal"><i class="bi bi-pencil me-1"></i>New Post</button></div>'+
