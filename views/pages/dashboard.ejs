/* ── ACTIONS ── */
function approvePost(id){api('/posts/'+id+'/approve',{method:'PUT'}).then(function(){toast('Post approved!','success');loadView('pending');}).catch(function(e){toast(e.message,'error');});}
function rejectPost(id){if(!confirm('Reject this post?'))return;api('/posts/'+id+'/reject',{method:'PUT'}).then(function(){toast('Post rejected');loadView('pending');}).catch(function(e){toast(e.message,'error');});}
function deletePost(id,rv){if(!confirm('Delete this post? This cannot be undone.'))return;api('/posts/'+id,{method:'DELETE'}).then(function(){toast('Post deleted','success');loadView(rv||'my-posts');}).catch(function(e){toast(e.message,'error');});}
function toggleUser(id){api('/dashboard/admin/users/'+id+'/toggle',{method:'PUT'}).then(function(){toast('Updated','success');loadView('users');}).catch(function(e){toast(e.message,'error');});}
function deleteUser(id){if(!confirm('Delete this user? This cannot be undone.'))return;api('/dashboard/admin/users/'+id,{method:'DELETE'}).then(function(){toast('Deleted','success');loadView('users');}).catch(function(e){toast(e.message,'error');});}
function deleteAnn(id){if(!confirm('Delete this announcement?'))return;api('/announcements/'+id,{method:'DELETE'}).then(function(){toast('Deleted','success');loadView('ann-manage');}).catch(function(e){toast(e.message,'error');});}

function submitPost(){
  var title=document.getElementById('post-title').value.trim();
  var dept_id=document.getElementById('post-dept').value;
  var content=document.getElementById('post-content').value.trim();
  var tags=document.getElementById('post-tags').value.split(',').map(function(t){return t.trim();}).filter(Boolean);
  if(!title||!content){toast('Title and content required','error');return;}
  if(!dept_id){toast('Please select a department','error');return;}
  api('/posts',{method:'POST',body:{title:title,content:content,dept_id:parseInt(dept_id),tags:tags}}).then(function(){
    toast('Post submitted for review!','success');
    var m=bootstrap.Modal.getInstance(document.getElementById('postModal')); if(m)m.hide();
    ['post-title','post-content','post-tags'].forEach(function(id){document.getElementById(id).value='';});
    loadView('my-posts');
  }).catch(function(e){toast(e.message||'Failed to submit.','error');});
}
function submitAnn(){
  var title=document.getElementById('ann-title').value.trim();
  var content=document.getElementById('ann-content').value.trim();
  var category=document.getElementById('ann-cat').value;
  if(!title||!content){toast('Title and content required','error');return;}
  api('/announcements',{method:'POST',body:{title:title,content:content,category:category}}).then(function(){
    toast('Announcement published!','success');
    var m=bootstrap.Modal.getInstance(document.getElementById('annModal')); if(m)m.hide();
    loadView('ann-manage');
  }).catch(function(e){toast(e.message,'error');});
}

/* ── INIT ── */
buildSidebar();
loadView('overview');
loadNotifications();
</script>
