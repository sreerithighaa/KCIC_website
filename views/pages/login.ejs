<%- include('../partials/header', { title: 'Sign In', activePage: '' }) %>

<div class="container py-5" style="min-height:calc(100vh - 130px)">
  <div class="row justify-content-center align-items-center" style="min-height:70vh">
    <div class="col-12 col-lg-9">
      <div class="bg-white rounded-4 shadow-sm overflow-hidden">
        <div class="row g-0">

          <!-- Left panel -->
          <div class="col-12 col-md-4 auth-left d-none d-md-flex">
            <h4 class="fw-bold text-navy mb-2" style="font-family:'Playfair Display',serif">Welcome Back!</h4>
            <p class="text-kcic-muted small mb-3">
              Access your KCC academic account, view announcements and your dashboard.
            </p>
            <div class="auth-logo-box">
              <img src="/assets/logo.png" alt="KCIC" class="logo-img" onerror="this.style.display='none'" />
            </div>
            <a href="/register" class="btn btn-outline-secondary w-100 mt-3">Create Account</a>
          </div>

          <!-- Right panel -->
          <div class="col-12 col-md-8 auth-right">
            <nav aria-label="breadcrumb" class="mb-3">
              <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="/home" class="text-kcic-muted text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-kcic-muted">Login</li>
              </ol>
            </nav>

            <h3 class="fw-bold text-navy mb-1" style="font-family:'Playfair Display',serif">Sign In</h3>
            <p class="text-kcic-muted small mb-4">Access your KCC academic account.</p>

            <div id="login-error" class="alert alert-danger py-2 small d-none"></div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Email</label>
              <input type="email" id="email" class="form-control" placeholder="Enter your email" />
              <div class="invalid-feedback" id="email-err"></div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Password</label>
              <div class="input-group">
                <input type="password" id="password" class="form-control" placeholder="Enter your password" />
                <button class="btn btn-outline-secondary" type="button" id="pw-toggle">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
              <div class="invalid-feedback d-block" id="pw-err"></div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="remember" />
                <label class="form-check-label small" for="remember">Remember me</label>
              </div>
              <a href="#" class="small text-decoration-none" style="color:var(--kcic-accent)">Forgot password?</a>
            </div>

            <button class="btn btn-gold w-100 py-2" id="login-btn" onclick="doLogin()">Sign In</button>
            <p class="text-center small text-kcic-muted mt-3 d-md-none">
              No account? <a href="/register" style="color:var(--kcic-accent)">Create one</a>
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
  if (Auth.isLoggedIn()) location.href = '/dashboard';

  document.getElementById('pw-toggle').addEventListener('click', () => {
    const inp = document.getElementById('password');
    const icon = document.querySelector('#pw-toggle i');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
  });

  async function doLogin() {
    const email = document.getElementById('email').value.trim();
    const pw    = document.getElementById('password').value;
    const errEl = document.getElementById('login-error');
    const btn   = document.getElementById('login-btn');

    document.getElementById('email-err').textContent = '';
    document.getElementById('pw-err').textContent = '';
    errEl.classList.add('d-none');

    if (!email) { document.getElementById('email-err').textContent = 'Please enter your email'; return; }
    if (!pw)    { document.getElementById('pw-err').textContent = 'Please enter your password'; return; }

    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Signing in…';

    try {
      const data = await api('/auth/login', { method: 'POST', body: { email, password: pw } });
      Auth.save(data.token, data.user);
      toast('Login successful!', 'success');
      setTimeout(() => location.href = '/dashboard', 700);
    } catch(e) {
      errEl.textContent = e.message || 'Login failed. Please check your credentials.';
      errEl.classList.remove('d-none');
      btn.disabled = false; btn.textContent = 'Sign In';
    }
  }
  document.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
</script>
