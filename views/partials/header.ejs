<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' – KCIC' : 'Kings Cornerstone International College' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/home">
      <img src="https://placehold.co/40x40/1a2744/c9a84c?text=KC" alt="KCIC Logo" width="40" height="40" class="rounded" onerror="this.style.display='none'" />
      <div class="lh-1">
        <span class="fw-bold d-block" style="font-family:'Playfair Display',serif;color:#1a2744;font-size:.95rem">KINGS</span>
        <span class="text-muted d-block" style="font-size:.72rem;letter-spacing:.05em">CORNERSTONE</span>
      </div>
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 bg-light rounded-pill px-2 py-1">
        <li class="nav-item">
          <a class="nav-link px-3 rounded-pill <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active bg-white shadow-sm fw-semibold' : 'text-secondary' %>" href="/home">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3 rounded-pill <%= typeof activePage !== 'undefined' && activePage === 'announcements' ? 'active bg-white shadow-sm fw-semibold' : 'text-secondary' %>" href="/announcements">Announcements</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3 rounded-pill <%= typeof activePage !== 'undefined' && activePage === 'blogs' ? 'active bg-white shadow-sm fw-semibold' : 'text-secondary' %>" href="/blogs">Blogs</a>
        </li>
        <li class="nav-item" id="nav-login-pill">
          <a class="nav-link px-3 rounded-pill text-secondary" href="/login">Login</a>
        </li>
      </ul>

      <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
        <a href="/register" id="nav-register" class="btn btn-navy btn-sm text-white px-3">Register</a>
        <a href="/dashboard" id="nav-dash" class="btn btn-outline-secondary btn-sm d-none">
          <i class="bi bi-speedometer2 me-1"></i>Dashboard
        </a>
        <button id="nav-logout" class="btn btn-outline-danger btn-sm d-none">
          <i class="bi bi-box-arrow-right me-1"></i>Logout
        </button>
      </div>
    </div>
  </div>
</nav>
